{
  "name": "dahl-studio",
  "productName": "Dahl Studio",
  "version": "0.3.3",
  "description": "Local-first Windows coding studio powered by the Dahl API",
  "author": "Dahl Studio",
  "main": "./out/main/index.js",
  "private": true,
  "repository": "github:Nexkeys/dahl-studio",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run typecheck && npm run test && electron-vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.15.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "@modelcontextprotocol/server-filesystem": "2.0.1",
